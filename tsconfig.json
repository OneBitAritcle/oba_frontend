{
    "compilerOptions":  {
                            "jsx":  "react-jsx",
                            "strict":  true,
                            "moduleResolution":  "bundler",
                            "target":  "esnext",
                            "allowJs":  true,
                            "esModuleInterop":  true,
                            "skipLibCheck":  true
                        },
    "extends":  "expo/tsconfig.base",
    "include":  [
                    "**/*.ts",
                    "**/*.tsx",
                    ".expo/types/**/*.ts",
                    "expo-env.d.ts"
                ]
}
