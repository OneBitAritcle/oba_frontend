{
  "expo": {
    "name": "oba_frontend",
    "slug": "oba_frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"],
    "scheme": "myapp",

    "ios": {
      "bundleIdentifier": "com.onebitearticle",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": true
    },

    "android": {
      "package": "com.onebitearticle",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon.png"
      }
    },

    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-build-properties",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
