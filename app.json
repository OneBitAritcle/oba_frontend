{
  "expo": {
    "name": "oba_frontend",
    "slug": "oba_frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "myapp",

    "platforms": ["ios", "android"],

    "ios": {
      "bundleIdentifier": "com.obacrew.app"
    },

    "android": {
      "package": "com.obacrew.app"
    },

    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],

    "experiments": {
      "typedRoutes": true
    }
  }
}
