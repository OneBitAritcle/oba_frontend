{
  "expo": {
    "name": "oba_frontend",
    "slug": "oba_frontend",
    "scheme": "myapp",
    "version": "1.0.0",
    "platforms": ["ios", "android", "web"],

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.obafrontend.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsArbitraryLoadsInWebContent": true
        }
      }
    },

    "android": {
      "package": "com.obafrontend.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "myapp",
              "host": "*",
              "pathPrefix": "/"
            }
          ]
        }
      ]
    },

    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "EXPO_PUBLIC_API_URL": "https://bc305808f731.ngrok-free.app",
      "EXPO_PUBLIC_NAVER_REDIRECT_URI": "myapp://oauth/naver",
      "EXPO_PUBLIC_GOOGLE_REDIRECT_URI": "myapp://oauth/google"
    }
  }
}
